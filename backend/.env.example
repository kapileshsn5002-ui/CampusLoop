# Spring Boot Backend Environment Variables
SERVER_PORT=8080

# Database Configuration (Railway MySQL)
# Use JDBC format: jdbc:mysql://HOST:PORT/DATABASE
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/campusloop
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# CORS — comma-separated list of allowed frontend origins
# For production, set to your Vercel domain (e.g. https://campusloop.vercel.app)
CORS_ALLOWED_ORIGINS=*
